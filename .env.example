# Caminho da pasta com as dez classes extraídas (relativo à raiz do projeto)
DATA_DIR=dados/raw/NWPU-RESISC45
# Mesmo lote nas duas resoluções; reduza só se faltar memória e registre a alteração
BATCH_SIZE_128=32
BATCH_SIZE_256=32
MAX_EPOCHS=40
PATIENCE=8
# Distância de Hamming máxima (hash de 256 bits) para considerar duas imagens versões da mesma cena
NEAR_DUP_THRESHOLD=12
